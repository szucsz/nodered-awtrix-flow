    {
        "id": "c9ef14c8efa4c355",
        "type": "function",
        "z": "cb45ad9576c38512",
        "name": "compute time left",
        "func": "let status = \"green\";\nlet text = \"\";\nif (msg.payload && msg.payload.connections) {\n    let connections = msg.payload.connections;\n\n    // Cache up to the next 4 departures (extracting departure timestamps)\n    let departureCache = [];\n    for (let i = 0; i < Math.min(connections.length, 10); i++) {\n        if (connections[i].from && connections[i].from.departure) {\n            departureCache.push(connections[i].from.departure);\n        }\n    }\n\n    const now = new Date();\n    context.set('departureCache', departureCache);\n    status = \"blue\";\n} \n\nlet departures = context.get('departureCache') || [];\n\nconst now = new Date();\nlet nextDepartureStr = null;\n\n// Clean up stale (past) departures from our cache\nwhile (departures.length > 0) {\n    let depTime = new Date(departures[0]);\n    if (depTime > now) {\n        nextDepartureStr = departures[0];\n        break; // Found our closest upcoming departure\n    } else {\n        departures.shift(); // Remove past departure\n    }\n}\ncontext.set('departureCache', departures);\n\nif (!nextDepartureStr) {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"no departure data\" });\n    return { payload: \"\" };\n}\ntext = `Cached ${departures.length}`;\n\n// Calculate time window variables\nconst departureTime = new Date(nextDepartureStr);\nconst msUntilDeparture = departureTime.getTime() - now.getTime();\nconst minsUntilDeparture = Math.round(msUntilDeparture / 60000);\n\nlet displayValue = \"\";\n\nif (minsUntilDeparture > 4 && minsUntilDeparture <= 6) {\n    displayValue = \"green\";\n} else if (minsUntilDeparture > 2 && minsUntilDeparture <= 4) {\n    displayValue = \"yellow\";\n} else if (minsUntilDeparture > 1 && minsUntilDeparture <= 2) {\n    displayValue = \"red\";\n}\n\nnode.status({ fill: status, shape: \"dot\", text: `${displayValue} (${minsUntilDeparture}m left) ${text}` });\n\nreturn { payload: displayValue };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1690,
        "y": 380,
        "wires": [
