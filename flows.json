    {
        "id": "c9ef14c8efa4c355",
        "type": "function",
        "z": "cb45ad9576c38512",
        "name": "compute time left",
        "func": "let departures = context.get('departureCache') || [];\n\nif (departures.length === 0) {\n    flow.set('display', \"\");\n    node.status({ fill: \"red\", shape: \"ring\", text: \"No departures cached yet\" });\n    return { payload: \"\" };\n}\n\nconst now = new Date();\nnode.warn(`now: ${now}`);\nlet nextDepartureStr = null;\n\n// Clean up stale (past) departures from our cache\nwhile (departures.length > 0) {\n    let depTime = new Date(departures[0]);\n    if (depTime > now) {\n        nextDepartureStr = departures[0];\n        break; // Found our closest upcoming departure\n    } else {\n        departures.shift(); // Remove past departure\n        node.warn(`dropped: ${depTime}`);\n    }\n}\ncontext.set('departureCache', departures);\n\n// If all cached departures are in the past, wait for the next 5-min API refresh\nif (!nextDepartureStr) {\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"All cached departures passed\" });\n    return { payload: \"\" };\n}\n\n// Calculate time window variables\nconst departureTime = new Date(nextDepartureStr);\nconst msUntilDeparture = departureTime.getTime() - now.getTime();\nconst minsUntilDeparture = msUntilDeparture / 60000;\n\nlet displayValue = \"\";\n\nif (minsUntilDeparture > 4 && minsUntilDeparture <= 6) {\n    displayValue = \"green\";\n} else if (minsUntilDeparture > 2) {\n    displayValue = \"yellow\";\n} else if (minsUntilDeparture <= 2) {\n    displayValue = \"red\";\n}\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `Display: ${displayValue} (${Math.round(minsUntilDeparture)}m left)` });\n\nreturn { payload: displayValue };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 990,
        "y": 420,
        "wires": [
            [
                "f5263ef7bb4b07e9"
            ]
        ]
    }
